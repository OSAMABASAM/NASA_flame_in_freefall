{
  "name": "flame-in-freefall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "predev": "npm run data",
    "dev": "next dev --turbopack",
    "prebuild": "npm run data && npm run cache",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "cache": "node --no-warnings scripts/cache-answers.mjs",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/network-drag.cjs",
    "test:demo": "node tests/e2e/demo-flow.cjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
